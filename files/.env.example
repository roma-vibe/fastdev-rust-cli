# Display name of the tool. build.rs compiles it into the binary (the first line of --help).
APP_NAME='My Tool'

# Machine-friendly name: the executable (package.name in Cargo.toml).
APP_SLUG=my-tool

# Arguments the development loop (scripts/dev.sh) runs the tool with after every rebuild.
DEV_ARGS='stats README.md Cargo.toml'
